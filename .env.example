# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ontime

# Security configuration
SECRET_KEY=generate_a_secure_random_string_here_like_openssl_rand_base64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# ML Service configuration
ML_API_URL=http://XX.XXX.XXX.XX:8000

# Mapbox (for frontend map — get a free token at mapbox.com)
# Add to frontend/.env as VITE_MAPBOX_TOKEN=...

# Scorer weights (must sum to 1.0)
WEIGHT_ETA=0.40
WEIGHT_DELAY_RISK=0.40
WEIGHT_PREFERENCE=0.10
WEIGHT_SAFETY=0.05
WEIGHT_UNCERTAINTY=0.05
